# Supabase Configuration
# Supabase 대시보드 (https://supabase.com) > Project Settings > API 에서 확인 가능합니다.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 검증 모드(개발자용): true면 AI 리포트에 두 엔진 비교표·감사 로그 원문 카드를 항상 표시 (발표용)
# 평소에는 비워 두고, 필요할 때 주소 뒤에 ?verify=1 을 붙여 켭니다.
VITE_VERIFY_MODE=
