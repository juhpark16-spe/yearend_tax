# Server Configuration
PROJECT_NAME="AI 셀프 연말정산(SelfTax 2025)"
ENVIRONMENT=development
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./selftax.db

# Security & PII
SECRET_KEY=your-secret-key-here-for-jwt-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Tax Rule Base Year
TAX_YEAR=2025

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Tavily API Key (Optional)
TAVILY_API_KEY=your-tavily-api-key-here
