# Server Configuration
PROJECT_NAME="AI 셀프 연말정산(SelfTax 2025)"
ENVIRONMENT=development
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./selftax.db

# Security & PII
SECRET_KEY=your-secret-key-here-for-jwt-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Tax Rule Base Year
TAX_YEAR=2025

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Tavily API Key (Optional)
TAVILY_API_KEY=your-tavily-api-key-here

# Supabase JWT 서명 검증 (운영 환경 필수 — 둘 중 하나 이상)
# 신규 프로젝트(비대칭 서명키): Supabase 프로젝트 URL → /auth/v1/.well-known/jwks.json 공개키로 검증
SUPABASE_URL=
# 레거시 프로젝트(HS256): Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# 게스트(로그인 없이 둘러보기) 토큰 서명 키 — 운영 환경에서는 임의의 긴 문자열로 설정 (미설정 시 SECRET_KEY 사용)
GUEST_TOKEN_SECRET=
GUEST_SESSION_TTL_HOURS=24
