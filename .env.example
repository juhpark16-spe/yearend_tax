# Server Configuration
PROJECT_NAME="AI 셀프 연말정산(SelfTax 2025)"
ENVIRONMENT=development
API_V1_STR=/api/v1
PORT=8000
HOST=0.0.0.0

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Database
DATABASE_URL=sqlite:///./selftax.db

# Security & PII
SECRET_KEY=your-secret-key-here-for-jwt-token
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Tax Rule Base Year
TAX_YEAR=2025

# OpenAI API Key
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Tavily API Key (Optional)
TAVILY_API_KEY=your-tavily-api-key-here

# Supabase JWT 서명 검증 (운영 환경 필수 — 둘 중 하나 이상)
# 신규 프로젝트(비대칭 서명키): Supabase 프로젝트 URL → /auth/v1/.well-known/jwks.json 공개키로 검증
SUPABASE_URL=
# 레거시 프로젝트(HS256): Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# 게스트(로그인 없이 둘러보기) 토큰 서명 키 — 운영 환경에서는 임의의 긴 문자열로 설정 (미설정 시 SECRET_KEY 사용)
GUEST_TOKEN_SECRET=
GUEST_SESSION_TTL_HOURS=24

# 요청 횟수 제한 ("횟수/초") — 여러 서버로 운영하면 Redis 등 공유 저장소 방식으로 교체 필요
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GUEST=10/600
RATE_LIMIT_AI=20/600
RATE_LIMIT_AI_PER_IP=40/600
RATE_LIMIT_UPLOAD=30/600
RATE_LIMIT_DEFAULT=120/60
# 리버스 프록시(Nginx 등) 뒤에서만 true
TRUST_PROXY_HEADERS=false

# 서버 자료 보존 기간(일): 마지막 사용 후 지나면 세션·문서·결과·감사로그 자동 삭제
DATA_RETENTION_DAYS=30

# DB 구조 관리: 지정하지 않으면 개발 환경은 시작 시 자동 'alembic upgrade head', 운영은 버전 확인만
# DB_AUTO_MIGRATE=true
